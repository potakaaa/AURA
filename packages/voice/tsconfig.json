{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "composite": false
  },
  "include": ["*.ts", "*.d.ts", "wake-word/**/*", "stt/**/*", "tts/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"],
}
