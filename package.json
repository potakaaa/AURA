{
  "name": "aura",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "turbo run build",
    "build:eas": "cd apps/mobile && eas build --profile development --platform android",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "check:no-hardcoded-colors": "node scripts/check-no-hardcoded-colors.mjs",
    "dev": "turbo run dev",
    "dev:mobile": "pnpm --filter mobile dev",
    "dev:api": "pnpm --filter api dev",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "version": "1.0.0",
  "dependencies": {
    "expo": "~54.0.33",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "pnpm": {
    "patchedDependencies": {
      "expo-keep-awake@15.0.8": "patches/expo-keep-awake@15.0.8.patch"
    }
  }
}
