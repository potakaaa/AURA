PORT=4000
NODE_ENV=development

# LLM provider settings
# Options: openai-compatible, openai, ollama, gemini
# Common base URLs:
# - openai-compatible/openai: https://api.openai.com/v1
# - ollama: http://localhost:11434
# - gemini: https://generativelanguage.googleapis.com/v1beta
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=30000

# Native Ollama example. The API server must be able to reach this host.
# For local Mac development, services/api can usually reach localhost directly.
# For containerized or remote API deployments, set LLM_BASE_URL to the host
# reachable from the API process, not from the mobile app.
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_TIMEOUT_MS=60000

# Native Gemini example.
# Use LLM_PROVIDER=openai-compatible with
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# only when intentionally using Gemini's OpenAI-compatible API.
# LLM_PROVIDER=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# LLM_API_KEY=
# LLM_MODEL=gemini-3.5-flash
# LLM_TIMEOUT_MS=30000
